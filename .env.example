# feast-agent configuration. Copy to .env (git-ignored) and fill in what you have.
# Never commit .env, and never paste a key that holds real money into it.

# sandbox (default) or mainnet. Mainnet is read-only in this release.
FEAST_NETWORK=
# Optional JSON-RPC overrides, one per network; the public endpoints are built in.
# A keyed URL is redacted from the agent's messages, but keep it out of shared logs anyway.
FEAST_SANDBOX_RPC_URL=
FEAST_MAINNET_RPC_URL=
# A THROWAWAY sandbox key (0x + 64 hex). `npm run faucet` creates one here if this is empty.
FEAST_AGENT_PRIVATE_KEY=

# Binance Web3 API credentials, from https://web3.binance.com/en/dev-portal (create a project).
# Requests are HMAC-signed, so the API needs both the key and its secret key.
BINANCE_WEB3_API_KEY=
BINANCE_WEB3_API_SECRET=
# Optional: another base URL (default https://web3.binance.com/build).
BINANCE_WEB3_BASE_URL=
# Optional: a directory to write every Binance response to (for fixtures and the DX log).
BINANCE_WEB3_RECORD_DIR=
# Optional: set to 1 to skip the keyless Binance Wallet Skill fallback in `quote`.
FEAST_AGENT_NO_SKILL=
